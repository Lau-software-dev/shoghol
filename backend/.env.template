PORT=5000
MODE=development

# MongoDB Atlas connection string (or run `npm run dev:memory` to skip this)
MONGO_URI=your_mongo_db_connection_string
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key

FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_PROD_URL=https://your-frontend.example.com

# Behind a hosting proxy (Render, Railway…) set to 1
TRUST_PROXY=0
# Only if the frontend and API are on different sites in production
CROSS_SITE_COOKIES=false

# Optional site-wide rate limit (leave empty to turn off)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60
